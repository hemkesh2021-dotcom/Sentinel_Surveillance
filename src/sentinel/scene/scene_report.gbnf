boolean ::= ("true" | "false") space
char ::= [^"\\\x7F\x00-\x1F] | [\\] (["\\bfnrt] | "u" [0-9a-fA-F]{4})
fire-or-smoke-kv ::= "\"fire_or_smoke\"" space ":" space boolean
observations ::= "[" space (observations-item ("," space observations-item){0,4})? "]" space
observations-item ::= "\"" char{1,80} "\"" space
observations-kv ::= "\"observations\"" space ":" space observations
persons-visible ::= ([0-9] | ([1-4] [0-9] | [5] "0")) space
persons-visible-kv ::= "\"persons_visible\"" space ":" space persons-visible
ref-defs-Threat ::= ("\"none\"" | "\"low\"" | "\"medium\"" | "\"high\"") space
ref-defs-Uncertainty ::= ("\"low\"" | "\"medium\"" | "\"high\"") space
root ::= "{" space persons-visible-kv "," space fire-or-smoke-kv "," space threat-kv "," space observations-kv "," space uncertainty-kv "," space summary-kv "}" space
space ::= | " " | "\n"{1,2} [ \t]{0,20}
summary ::= "\"" char{0,160} "\"" space
summary-kv ::= "\"summary\"" space ":" space summary
threat ::= ref-defs-Threat
threat-kv ::= "\"threat\"" space ":" space threat
uncertainty ::= ref-defs-Uncertainty
uncertainty-kv ::= "\"uncertainty\"" space ":" space uncertainty
